<!--
  WinSW configuration for the GRIPHOOK backend service.

  WinSW runs a launcher batch script (griphook-start.bat, generated at
  install time by install.ps1 Write-BackendLauncher) instead of java.exe
  directly. The launcher reads .env into the process environment on every
  service start, so editing .env + restarting the service picks up the
  new values WITHOUT regenerating this xml (the previous design cached
  <env> entries at install time, which silently went stale).

  %BASE% expands to the directory holding this xml + the WinSW exe
  (i.e. the install dir, e.g. C:\ProgramData\Griphook).
-->
<service>

  <!-- Unique service id (registry key name) -->
  <id>Griphook</id>
  <!-- Display name shown in services.msc -->
  <name>Griphook Service</name>
  <description>GRIPHOOK AI-Powered Deployment Agent (backend)</description>

  <!-- cmd.exe launches the wrapper batch script -->
  <executable>cmd.exe</executable>
  <arguments>/c "%BASE%\griphook-start.bat"</arguments>
  <workingdirectory>%BASE%</workingdirectory>

  <!-- Log rotation: 10 MB per file, keep 8 archives (sizeThreshold is in KB) -->
  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>

  <startmode>Automatic</startmode>

</service>