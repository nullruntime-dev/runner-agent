<!--
  WinSW configuration for the GRIPHOOK UI service.

  WinSW runs a launcher batch script (griphook-start-ui.bat, generated
  at install time by install.ps1 Write-FrontendLauncher) instead of
  node.exe directly. The launcher reads .env into the process
  environment on every service start, so editing .env + restarting the
  service picks up new values WITHOUT regenerating this xml.

  %BASE% expands to the directory holding this xml + the WinSW exe
  (i.e. the install dir). The Next.js binary lives under
  %BASE%\ui\node_modules\next\dist\bin\next.
-->
<service>

  <id>GriphookUI</id>
  <name>Griphook UI</name>
  <description>GRIPHOOK UI Dashboard</description>

  <executable>cmd.exe</executable>
  <arguments>/c "%BASE%\griphook-start-ui.bat"</arguments>
  <workingdirectory>%BASE%\ui</workingdirectory>

  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>

  <startmode>Automatic</startmode>
  <!-- UI starts after the backend so the dashboard can reach the API -->
  <depend>Griphook</depend>

</service>